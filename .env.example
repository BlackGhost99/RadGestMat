# ============================================
# Template de Configuration - RadGestMat
# ============================================
# Copier ce fichier vers .env et remplir les valeurs
# cp .env.example .env

# Environnement (development, staging, production)
ENVIRONMENT=production
DEBUG=False

# Sécurité - Générer une nouvelle clé avec: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here-min-50-chars

# Serveur - Liste des hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=10.105.42.118,LBVH.rezidor.com,localhost,127.0.0.1

# Base de données
# Pour SQLite (par défaut), laisser ces lignes commentées
# Pour PostgreSQL, décommenter et configurer:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=radgestmat
# DB_USER=radgestmat
# DB_PASSWORD=your_password_here
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=600

# Redis (cache et sessions)
# Format: redis://host:port/db
REDIS_URL=redis://redis:6379/1

# Email (optionnel)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=RadGestMat <noreply@LBVH.rezidor.com>

# QR Codes - Domaine de base pour les URLs des QR codes
QR_DOMAIN=http://LBVH.rezidor.com
SITE_URL=http://LBVH.rezidor.com

# Gunicorn (pour déploiement avec Docker)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Sentry (optionnel - pour le suivi d'erreurs en production)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Twilio WhatsApp (optionnel - pour les notifications)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
